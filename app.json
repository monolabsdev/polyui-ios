{
  "expo": {
    "name": "polyui-ios",
    "slug": "polyui-ios",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "polyuiios",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.theoslater.polyuiios",
      "icon": "./assets/expo.icon"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-notifications",
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "expo-status-bar",
      "expo-font",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
